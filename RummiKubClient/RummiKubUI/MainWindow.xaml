<Window x:Class="RummiKubUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RummiKubUI"
        mc:Ignorable="d"
        Title="Rummikub" Height="600" Width="1000"
        Icon="/Assets/RummiKubIcon (1).png" 
         KeyDown="Window_KeyDown"
        ResizeMode="NoResize"  
        WindowStyle="SingleBorderWindow"
        >
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Viewbox Stretch="Fill" >
            <Grid Width="1000" Height="600">
            
                <Frame x:Name="GameFrame" NavigationUIVisibility="Hidden"/>
                <Border x:Name="ErrorBox" Visibility="Collapsed"  Opacity="0" BorderThickness="2" CornerRadius="1" Background="White" BorderBrush="#FF690C0C" Width="800" Height="45" VerticalAlignment="Top" Margin="0,60,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="#FF690C0C" BorderThickness="0,0,2,0">
                            <TextBlock x:Name="BoxSign"  Text="⚠" FontSize="30" VerticalAlignment="Center" Foreground="Red"/>
                        </Border>
                        <TextBlock x:Name="ErrorMessage" FontSize="20" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
