<Page x:Class="RummiKubUI.FriendPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RummiKubUI.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FriendPage"
      Background="CadetBlue">
    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="ArrowPopupStyle" TargetType="Popup">
                <Setter Property="AllowsTransparency" Value="True"/>
                <Setter Property="PopupAnimation" Value="Fade"/>
            </Style>

            <Style x:Key="MenuButtonStyle2" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MenuButtonStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="#1E3A8A"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#4299E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2C5282"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#4299E1"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>


    <Viewbox Stretch="Uniform">
        <Grid Height="500" Width="800">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" x:Name="HeadBackButtonPanel"  VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <ToggleButton x:Name="AddFriendButton" Content="Add Friend" Width="150" Height="30" Style="{StaticResource MenuButtonStyle}"  Checked="AddFriendButton_Checked"  Unchecked="AddFriendButton_Unchecked"/>
                <ToggleButton x:Name="FriendsButton" Content="Friends" Width="150" Height="30" Style="{StaticResource MenuButtonStyle}" Checked="FriendsButton_Checked"  Unchecked="FriendsButton_Unchecked"/>
                <ToggleButton x:Name="FriendRequestButton" Content="Friend Requests " Width="150" Height="30" Style="{StaticResource MenuButtonStyle}" Checked="FriendRequestButton_Checked"  Unchecked="FriendRequestButton_Unchecked" />
            </StackPanel>
            <local:GameInvitesUserControl Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Right" Width="400"/>
            <Grid Height="400" Grid.Row="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="title" FontSize="30" HorizontalAlignment="Center" />

                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Center" Grid.Row="1" Width="250">
                    <Border  BorderBrush="Black" CornerRadius="30" BorderThickness="3"  Grid.Row="1" >
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Filter:" FontSize="20" HorizontalAlignment="Left" Margin="30"/>
                            <TextBox x:Name="UsernameFilter" VerticalContentAlignment="Center" Width="150" HorizontalAlignment="Right" Height="30" TextChanged="UsernameFilter_TextChanged" Margin="10"/>
                            <ItemsControl Grid.Row="1" x:Name="lstview" ItemsSource="{Binding}" HorizontalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="5"
                                    MouseRightButtonUp="ItemBorder_MouseRightButtonUp">
                                            <Grid Width="250">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Margin="20,0,0,0" HorizontalAlignment="Left" BorderThickness="0" Width="50" Height="50" Background="Transparent" Click="Button_Click" Grid.Column="0">
                                                    <Image Source="{Binding ButtonImage}" />
                                                </Button>
                                                <local:PlayerDisplayUserContorl Margin="0,0,40,0" HorizontalAlignment="Right" Grid.Column="1"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </ScrollViewer>
                <Popup x:Name="ContextMenuPopup"
       StaysOpen="False"
       Placement="AbsolutePoint"
       AllowsTransparency="True"
       PopupAnimation="Fade">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <Polygon x:Name="PopupArrow"
         Points="80,10 30,10 30,0 0,15 30,30 30,20 80,20"
         Fill="Black"
         Height="47"
         VerticalAlignment="center"  HorizontalAlignment="Right"
/>
                        <!-- Popup Box -->
                        <Border Background="White" Grid.Column="1"
              CornerRadius="5"
              BorderBrush="Black"
              BorderThickness="1"
              Padding="5">


                            <StackPanel Margin="10">
                                <Button Content="Invite to Game"
                      Style="{StaticResource MenuButtonStyle2}"
                      Click="InviteToGame_Click"/>
                                <Button Content="View Profile"
                      Style="{StaticResource MenuButtonStyle2}"
                      Click="ViewProfile_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </Grid>
        
    </Viewbox>
</Page>
