<Page x:Class="RummiKubUI.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RummiKubUI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StatisticsPage"
     Background="#0A192F">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Rectangle Grid.Row="0"
               Height="30"
               VerticalAlignment="Top"
               Fill="Black" Grid.ColumnSpan="2">
            <Rectangle.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>

        <RepeatButton Grid.Row="0" x:Name="ScrollUpButton"
      Content="▲"
      FontSize="16"
      Click="ScrollUpButton_Click"
      Background="Transparent"
      BorderBrush="Transparent"
      Foreground="White"
      Height="30"
      HorizontalAlignment="Center"
      Interval="10"/>


        <ScrollViewer x:Name="scrollViewer"
                  Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Height="200"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Grid.ColumnSpan="2">
            <StackPanel>
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Score:" Foreground="White" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Score" Grid.Column="1" Foreground="White" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Border Grid.ColumnSpan="2" Background="#1E3151" Height="2" VerticalAlignment="Bottom"/>
                </Grid>

                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Level:" Foreground="White" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Level" Grid.Column="1" Foreground="White" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Border Grid.ColumnSpan="2" Background="#1E3151" Height="2" VerticalAlignment="Bottom"/>
                </Grid>

                <Grid Margin="0,10,0,10">

                    <TextBlock Text="Total Exp:" Foreground="White" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Total_Exp" Foreground="White" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Border Background="#1E3151" Height="2" VerticalAlignment="Bottom"/>
                </Grid>

                <Grid Margin="0,10,0,10">

                    <TextBlock Text="Games Won:" Foreground="White" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Games_Won" Grid.Column="1" Foreground="White" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Border Grid.ColumnSpan="2" Background="#1E3151" Height="2" VerticalAlignment="Bottom"/>
                </Grid>

                <Grid Margin="0,10,0,10">

                    <TextBlock Text="Games Played:" Foreground="White" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Games_Played" Grid.Column="1" Foreground="White" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Border Grid.ColumnSpan="2" Background="#1E3151" Height="2" VerticalAlignment="Bottom"/>
                </Grid>

                <Grid Margin="0,10,0,10">

                    <TextBlock Text="Winning Percentage:" Foreground="White" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Winning_ratio" Grid.Column="1" Foreground="White" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Border Grid.ColumnSpan="2" Background="#1E3151" Height="2" VerticalAlignment="Bottom"/>
                </Grid>


            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Rectangle
   Height="30"
   VerticalAlignment="Bottom"
   Fill="Black" Grid.ColumnSpan="2">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="Black" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <RepeatButton x:Name="ScrollDownButton"
          Content="▼"
          FontSize="16"
          Click="ScrollDownButton_Click"
          Background="Transparent"
          BorderBrush="Transparent"
          Foreground="White"
          Height="30"
          HorizontalAlignment="Center"
          Interval="10"/>
        </Grid>



    </Grid>
</Page>
