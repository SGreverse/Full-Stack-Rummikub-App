<UserControl x:Class="RummiKubUI.UserControls.PlayerDisplayUserContorl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RummiKubUI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="100">
    <UserControl.Resources >
        <local:ImageConverter x:Key="imageConverter" />
        <local:UsernameConverter x:Key="usernameConverter"/>
        <local:TileAmountDisplayConverter x:Key="TileDisplayConverter" />

    </UserControl.Resources>
    <Grid Width="auto" Margin="0,5,0,-6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="10" >
            <Border x:Name="PlayerBorder" Width="50" Height="50" CornerRadius="25" BorderThickness="2" BorderBrush="#FF4A86E8">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" Direction="0" Color="#FF4A86E8" Opacity="1" BlurRadius="8"/>
                </Border.Effect>
                <Grid>
                    <Ellipse Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding IconName, Converter={StaticResource imageConverter}}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="InGameOverlay" Visibility="Hidden"  Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#CC000000" Opacity="0.6"/>
                    <TextBlock x:Name="PlayerStateOverlay" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="45" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Star Icon Overlay -->
        <Viewbox Grid.Row="0" Grid.Column="0" Width="auto" Height="36" 
         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-14,0">
            <Grid Width="32" Height="30">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>

                </Grid.ColumnDefinitions>
                <!-- Star Shape -->
                <Path Data="M12,2L15.09,8.26L22,9.27L17,14.14L18.18,21.02L12,17.77L5.82,21.02L7,14.15L2,9.27L8.91,8.26L12,2Z"
              Fill="Yellow" Stroke="#FF21416A" StrokeThickness="0.5"
              Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.ColumnSpan="2" Grid.RowSpan="2"/>

                <!-- Centered Text -->
                <TextBlock x:Name="UserLevelDisplay" Text="{Binding Level}"  FontSize="11" FontWeight="Bold" Foreground="White"
                   FontFamily="Arial" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" Grid.Row="1">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" Direction="315" Color="#FF21416A" Opacity="0.9" BlurRadius="3"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

        </Viewbox>
        <StackPanel Grid.Row="1" Height="auto">
            <TextBlock Margin="-7" x:Name="User" Text="{Binding Username, Converter={StaticResource usernameConverter}}" FontFamily="Segoe UI Bold"  Foreground="White" HorizontalAlignment="Center" FontWeight="Bold" Width="auto"/>

            <TextBlock x:Name="TileAmount" Foreground="White"   Text="{Binding TileAmount,Converter={StaticResource TileDisplayConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>
