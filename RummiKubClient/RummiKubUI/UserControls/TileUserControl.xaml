<UserControl x:Class="RummiKubUI.TileUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RummiKubUI"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="20">
    <UserControl.Resources>
        <local:TileConverter x:Key="tileConverter"/>
    </UserControl.Resources>
    <Grid x:Name="TileGrid" >
        <Button Click="ClickB1">
            <Button.Template>
                <ControlTemplate>
                    <Image Source="{Binding Converter={StaticResource tileConverter}}" Stretch="Fill"/>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
