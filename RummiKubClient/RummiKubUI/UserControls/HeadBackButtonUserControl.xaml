<UserControl x:Class="RummiKubUI.UserControls.HeadBackButtonUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RummiKubUI.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <DropShadowEffect x:Key="ButtonShadow" 
                  ShadowDepth="3" 
                  Direction="320" 
                  Color="Black" 
                  Opacity="0.5" 
                  BlurRadius="4"/>
    </UserControl.Resources>
    <Grid>
        <Button x:Name="HeadBackButton" 
    Width="140" 
    Height="50"
    Click="HeadBackButton_Click"
    Margin="10">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ButtonBorder"
                    Background="#3498db"
                    CornerRadius="25"
                    Effect="{StaticResource ButtonShadow}">
                            <Grid>
                                <Path x:Name="ArrowPath"
                          Data="M20,25 L35,10 L35,40 Z"
                          Fill="White"
                          Stretch="Uniform"
                          Width="20"
                          HorizontalAlignment="Left"
                          Margin="15,0,0,0"/>
                                <TextBlock Text="Head Back"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,15,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#2980b9"/>
                            <Setter TargetName="ArrowPath" Property="Fill" Value="#ECF0F1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#2471A3"/>
                            <Setter TargetName="ArrowPath" Property="Fill" Value="#D0D3D4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
