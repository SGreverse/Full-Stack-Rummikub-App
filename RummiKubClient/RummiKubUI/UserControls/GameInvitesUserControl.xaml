<UserControl x:Class="RummiKubUI.UserControls.GameInvitesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RummiKubUI.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Shrink and Zoom Out Animation -->
        <Storyboard x:Key="RemoveItemAnimation">
            <!-- Shrink slightly -->
            <DoubleAnimation Storyboard.TargetProperty="Height" To="45" Duration="0:0:0.2" />
            <!-- Zoom out to the right quickly -->
            <ThicknessAnimation Storyboard.TargetProperty="Margin" To="500,0,0,0" Duration="0:0:0.3" BeginTime="0:0:0.2" />
            <!-- Fade out quickly -->
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" BeginTime="0:0:0.2" />
        </Storyboard>

        <!-- Button Style to Remove Hover Effect -->
        <Style x:Key="NoHoverButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataTemplate for Game Invites -->
        <DataTemplate x:Key="GameInviteTemplate">
            <Border HorizontalAlignment="Right" Height="100" Width="250" Background="#1E3A8A" CornerRadius="5" Margin="5">
                <Grid>
                    <!-- Approve Button -->
                    <Button Width="30"
                         Height="30"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Margin="10,0,5,0"
                         Style="{StaticResource NoHoverButtonStyle}"
                         Click="ApproveButton_Click">
                        <TextBlock Text="✔"
                                FontSize="16"
                                Foreground="#32CD32"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Decline Button -->
                    <Button Width="30"
                         Height="30"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Margin="50,0,5,0"
                         Style="{StaticResource NoHoverButtonStyle}"
                         Click="DeclineButton_Click">
                        <TextBlock Text="✖"
                                FontSize="16"
                                Foreground="#FF6347"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Username -->
                    
                    <local:PlayerDisplayUserContorl Margin="0,0,30,0" FontSize="16" FontWeight="Bold"
                            Foreground="#FFFFFF" VerticalAlignment="Top" HorizontalAlignment="Right"
                            />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ItemsControl for dynamic game invites -->
        <ItemsControl x:Name="GameInvitesControl"
                   ItemsSource="{Binding GameInvites}"
                   ItemTemplate="{StaticResource GameInviteTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</UserControl>
