<Page x:Class="RummiKubUI.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RummiKubUI.ValidationRules"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="RegisterPage"
      >
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF3B7CB9" Offset="1.0" />
            <GradientStop Color="#FF2A5985" Offset="0.5" />
            <GradientStop Color="#FF1D3C5C" Offset="0.0" />
        </LinearGradientBrush>
    </Page.Background>

    <Page.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <Grid>
        <StackPanel x:Name="Backbutton" HorizontalAlignment="Left" />
        <Border x:Name="ContentBorder" CornerRadius="10" Background="White" Margin="20,20,20,20" MaxWidth="400" Width="auto" Height="auto">
            <Border.RenderTransform>
                <TranslateTransform Y="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#CCCCCC"/>
            </Border.Effect>
            <StackPanel x:Name="ContentStackPanel" Margin="10">
                <TextBlock Text="Create Account" FontWeight="Bold" FontSize="30"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" 
              BorderBrush="#2196F3" 
              BorderThickness="2" 
              CornerRadius="10" 
              Margin="10">


                        <Grid x:Name="PanelContainer" Height="auto">
                            <Grid.Effect>
                                <DropShadowEffect ShadowDepth="5" Color="#CCCCCC" Opacity="0.5" BlurRadius="10"/>
                            </Grid.Effect>

                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="24"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </Grid.Resources>

                            <Grid x:Name="Panel1" Height="300">
                                <StackPanel Width="300" Margin="20" HorizontalAlignment="Center">
                                    <TextBlock Text="Player Info"/>
                                    <StackPanel>
                                        <TextBlock Text="Username:" HorizontalAlignment="Left" FontSize="14"/>
                                        <Grid>
                                            <TextBox Name="UsernameTextBox" Height="30" Padding="5" BorderBrush="Gray" BorderThickness="1" TextChanged="OnTextBoxTextChanged">
                                                <Binding Path="Username" ValidatesOnDataErrors="True" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                                                    <Binding.ValidationRules>
                                                        <local:UsernameRule/>
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox>


                                            <TextBlock  Text="Enter username..." Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>

                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Password:" HorizontalAlignment="Left" FontSize="14"/>
                                        <Grid>
                                            <PasswordBox Name="PasswordBox" Height="30" Padding="5" BorderBrush="Gray" BorderThickness="1" PasswordChanged="PasswordBox_PasswordChanged" />
                                            <TextBlock Text="Enter password..." Foreground="Gray" Margin="10,0,0,0"
                   VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Confirm Password:" HorizontalAlignment="Left" FontSize="14"/>

                                        <Grid>
                                            <PasswordBox Name="ConfirmPasswordBox" Height="30" Padding="5" BorderBrush="Gray" BorderThickness="1"  PasswordChanged="PasswordBox_PasswordChanged"/>
                                            <TextBlock Text="Confirm password..." Foreground="Gray" Margin="10,0,0,0"
                   VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                            </Grid>

                            <Grid x:Name="Panel2" Height="400" Visibility="Collapsed" Opacity="0">
                                <StackPanel>
                                    <TextBlock Text="Personal Info"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="First Name:"/>
                                            <Grid>
                                                <TextBox Name="FirstNameTextBox" Height="30" Padding="5" BorderBrush="Gray" BorderThickness="1" TextChanged="OnTextBoxTextChanged">
                                                    <Binding Path="FirstName" ValidatesOnDataErrors="True" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                                                        <Binding.ValidationRules>
                                                            <local:NameRule/>
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox>
                                                <TextBlock  Text="Enter Your First Name..." Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>

                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel  Margin="10,0,0,0">
                                            <TextBlock Text="Last Name:"/>
                                            <Grid>
                                                <TextBox Name="LastNameTextBox" Height="30" Padding="5" BorderBrush="Gray" BorderThickness="1" TextChanged="OnTextBoxTextChanged">
                                                    <Binding Path="LastName" ValidatesOnDataErrors="True" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                                                        <Binding.ValidationRules>
                                                            <local:NameRule/>
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox>
                                                <TextBlock  Text="Enter Your Last Name..." Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>

                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                                        <TextBlock Text="Email:" HorizontalAlignment="Left"/>
                                        <Grid>
                                            <TextBox Name="EmailTextBox" Height="30" Padding="5" BorderBrush="Gray" BorderThickness="1" TextChanged="OnTextBoxTextChanged" Width="300">
                                                <Binding Path="Email" ValidatesOnDataErrors="True" UpdateSourceTrigger="PropertyChanged" NotifyOnValidationError="True">
                                                    <Binding.ValidationRules>
                                                        <local:EmailRule/>
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox>
                                            <TextBlock  Text="Enter Your Email..." Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>

                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Margin="0,20,0,0">
                                        <TextBlock Text=" Select your City:"/>
                                        <ComboBox x:Name="Cities" Grid.Column="1" Grid.Row="4" Margin="20" SelectedItem="{Binding User_City}"  DisplayMemberPath="CityName" VirtualizingStackPanel.IsVirtualizing="True"
          VirtualizingStackPanel.VirtualizationMode="Recycling">
                                            <ComboBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ComboBox.ItemsPanel>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="Panel3" Visibility="Collapsed" Opacity="0"  Height="250" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="200"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Icon Selection" />
                                <Grid x:Name="IconNavUC" Grid.Row="1"/>
                            </Grid>
                        </Grid>
                    </Border>
                    
                    
                    <StackPanel Grid.Row="1" 
                                
                  Orientation="Horizontal" 
                  HorizontalAlignment="Center" 
                  Margin="0,0,0,20">
                        <Button Content="Previous" 
                           x:Name="PreviousButton"
                                Visibility="Hidden"
                  Width="100" 
                  Height="40" 
                  Margin="0,0,10,0"
                  Click="PreviousButton_Click"
                  Style="{StaticResource ButtonStyle}"/>
                        <Button Content="Next" 
                      x:Name="NextButton"
                      Width="100" 
                      Height="40" 
                      Margin="10,0,0,0"
                      Click="FirstPanelValidation"
                      Style="{StaticResource ButtonStyle}"/>

                        <Button Content="Register" 
                      x:Name="RegisterButton"
                      Width="100" 
                      Height="40" 
                      Margin="10,0,0,0"
                      Click="RegisterButton_Click"
                       HorizontalAlignment="Right"
                        Visibility="Collapsed"
                      Style="{StaticResource ButtonStyle}"/>
                    </StackPanel>
                </Grid>
                <TextBlock HorizontalAlignment="Center" Foreground="Red" x:Name="ErrorTextBlock" />
                <TextBlock  HorizontalAlignment="Center" Text="Already have an Account? Log In" FontWeight="Bold" FontStyle="Italic" Foreground="Blue"/>

            </StackPanel>
        </Border>

    </Grid>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ContentStackPanel" 
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5"/>
                    <DoubleAnimation Storyboard.TargetName="ContentBorder" 
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="50" To="0" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
</Page>
