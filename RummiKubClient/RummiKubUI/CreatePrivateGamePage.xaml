<Page x:Class="RummiKubUI.CreatePrivateGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RummiKubUI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreatePrivateGamePage">

    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <TextBlock Text="Create Game" Foreground="White" FontSize="30" HorizontalAlignment="Center"/>
        <Button Content="Create" Width="100" Height="70" Click="Create_New_Game"/>
        </StackPanel>
    </Grid>
</Page>
