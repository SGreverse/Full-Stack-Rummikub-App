<Page x:Class="RummiKubUI.PlayerBoardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RummiKubUI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PlayerBoardPage">
    <Page.RenderTransform>
        <TranslateTransform x:Name="TileTranslateTransform"/>
    </Page.RenderTransform>
    <Grid>
        <StackPanel Orientation="Vertical" Margin="100,0,100,0">
            <StackPanel.Background>
                <ImageBrush ImageSource="Assets\RummiKub Board (1).png"/>

            </StackPanel.Background>
            <WrapPanel x:Name="AllPlayerTiles" HorizontalAlignment="Center"  />
        </StackPanel>
    </Grid>
</Page>
