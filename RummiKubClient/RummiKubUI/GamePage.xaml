<Page x:Class="RummiKubUI.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RummiKubUI"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GamePage"
       >
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E3A8A" Offset="0.0"/>
            <GradientStop Color="#2962FF" Offset="0.3"/>
            <GradientStop Color="#0D47A1" Offset="0.6"/>
            <GradientStop Color="#1A237E" Offset="1.0"/>
        </LinearGradientBrush>

    </Page.Background>
    <Page.Resources>
        <Style x:Key="GameButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D4A373"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                             BorderBrush="#C08E5D"
                             BorderThickness="1"
                             CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C08E5D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#A77A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="800" Height="450">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.RowSpan="3" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal">
                    <Grid>
                        <Rectangle Fill="Black" Height="50" Width="50" x:Name="MenuIconBackground" Opacity="0.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <TextBlock Text="≡" Margin="20,0,-2,5"  Height="55" Width="50" VerticalAlignment="Center" x:Name="MenuIcon" HorizontalAlignment="Center" FontSize="40" Foreground="White"/>
                        <Button Width="50" Height="50" x:Name="ShowMenu"  Background="Transparent" BorderThickness="0" Click="ShowMenu_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="OverridesDefaultStyle" Value="True"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Name="border" 
Padding="4,2" 
BorderThickness="2"
BorderBrush="DarkGray" 
CornerRadius="3" 
Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <Grid>
                        <Rectangle Fill="Black" Height="50" Width="50" x:Name="MessageIconBackground" Opacity="0.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <TextBlock Text="🗨️" Height="50" Width="54" VerticalAlignment="Center" x:Name="MessageIcon" HorizontalAlignment="Center" FontSize="40" Foreground="White"/>
                        <Button Width="50" Height="50" x:Name="ShowChat"  Background="Transparent" BorderThickness="0"  Click="ShowChat_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="OverridesDefaultStyle" Value="True"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Name="border" 
                                                     Padding="4,2" 
                                                     BorderThickness="2"
                                                     BorderBrush="DarkGray" 
                                                     CornerRadius="3" 
                                                     Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                </StackPanel>
                <StackPanel x:Name="UsersPanel" Grid.RowSpan="3"/>
            </StackPanel>
            <Frame x:Name="BoardFrame" NavigationUIVisibility="Hidden" Grid.Column="1" />
            <Frame x:Name="PlayerHandFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Grid.Column="1" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Grid.Column="1">
                <Button Width="50" Height="50" Content="Add" Click="Button_Click" />
                <Button Width="50" Height="50" Click="EndTurn_Click" x:Name="EndTurn" Content="End Turn" />
                <Button Width="50" Height="50" x:Name="ResetTurn" Content="Reset" Click="ResetTurn_Click" />
                <Button Width="50" Height="50" x:Name="DropTileAdmin" Content="Remove" Visibility="Collapsed" Click="DropTile_Click"  />
            </StackPanel>

            <!--Chat Overlay -->
            <Border x:Name="Chat" Grid.ColumnSpan="2" Grid.RowSpan="3" VerticalAlignment="Top" HorizontalAlignment="Left"    Margin="70,55,0,0"             
                Background="#CC000000" 
                Visibility="Collapsed">
                <Grid Width="354" Height="264">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="auto"/>

                    </Grid.RowDefinitions>
                    <ScrollViewer>
                        <StackPanel x:Name="MessagesContainer" Orientation="Vertical"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="Text:" FontSize="20"  Foreground="White"/>
                        <TextBox x:Name="Message" Width="280" KeyDown="Message_KeyDown"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!--Menu OverLay-->
            <Border x:Name="MenuOverlay" Grid.ColumnSpan="2" Grid.RowSpan="3" VerticalAlignment="Top" HorizontalAlignment="Left"
        Margin="10,55,0,0"
        Background="#CC000000"
        Visibility="Collapsed">
                <Grid Width="200" Height="100">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Surrender Button -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10">
                        <Button x:Name="Surrender" Click="Surrender_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Surrender" FontSize="20" Foreground="White"/>
                                                    <Image Source="/Assets/logout.png" Width="20" Height="20" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Game Details Button -->
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10">
                        <Button>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="Game Detailsℹ️" FontSize="20" Foreground="White"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Game Over Overlay -->
            <Border x:Name="GameEndOverlay"
                Background="#CC000000" 
                Visibility="Collapsed"
            Grid.RowSpan="3" Grid.ColumnSpan="2">

                <Grid Width="800" Height="450">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Game Over!"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,20"
                           Grid.Row="1" />

                    <TextBlock Text="You Recieved:"
                           x:Name="ScoreDisplay"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,20"
                            Grid.Row="2"/>
                    <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Grid.Row="3"
                            Margin="0,20,0,0">
                        <Button Content="Play Again"
                            Width="120"
                            Height="40"
                            Margin="10"
                            Style="{StaticResource GameButtonStyle}"
                            Click="PlayAgain_Click"/>

                        <Button Content="Main Menu"
                            Width="120"
                            Height="40"
                            Margin="10"
                            Style="{StaticResource GameButtonStyle}"
                            Click="ReturnToMenu_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="GameDeatilBox" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed">
                <TextBlock Text="Game Details" FontSize="20" Foreground="White"/>
            </Border>
        </Grid>
    </Viewbox>


</Page>
