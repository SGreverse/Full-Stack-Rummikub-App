<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://schemas.datacontract.org/2004/07/RummiKubClasses.Tiles" elementFormDefault="qualified" targetNamespace="http://schemas.datacontract.org/2004/07/RummiKubClasses.Tiles" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="Tile">
    <xs:sequence>
      <xs:element name="Color" type="tns:RummiColor" />
      <xs:element name="Value" type="xs:int" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="Tile" nillable="true" type="tns:Tile" />
  <xs:simpleType name="RummiColor">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Black" />
      <xs:enumeration value="Orange" />
      <xs:enumeration value="Red" />
      <xs:enumeration value="Blue" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="RummiColor" nillable="true" type="tns:RummiColor" />
  <xs:complexType name="ArrayOfTile">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="Tile" nillable="true" type="tns:Tile" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfTile" nillable="true" type="tns:ArrayOfTile" />
  <xs:complexType name="Joker">
    <xs:complexContent mixed="false">
      <xs:extension base="tns:Tile">
        <xs:sequence />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="Joker" nillable="true" type="tns:Joker" />
  <xs:complexType name="TileSeries">
    <xs:sequence>
      <xs:element name="Amount" type="xs:int" />
      <xs:element name="set" nillable="true" type="tns:ArrayOfTile" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="TileSeries" nillable="true" type="tns:TileSeries" />
  <xs:complexType name="RisingSeries">
    <xs:complexContent mixed="false">
      <xs:extension base="tns:TileSeries">
        <xs:sequence />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="RisingSeries" nillable="true" type="tns:RisingSeries" />
  <xs:complexType name="ColorSeries">
    <xs:complexContent mixed="false">
      <xs:extension base="tns:TileSeries">
        <xs:sequence />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="ColorSeries" nillable="true" type="tns:ColorSeries" />
  <xs:complexType name="ArrayOfTileSeries">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="TileSeries" nillable="true" type="tns:TileSeries" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfTileSeries" nillable="true" type="tns:ArrayOfTileSeries" />
</xs:schema>