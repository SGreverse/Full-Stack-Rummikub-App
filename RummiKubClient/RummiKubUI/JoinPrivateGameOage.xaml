<Page x:Class="RummiKubUI.JoinPrivateGameOage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RummiKubUI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="JoinPrivateGameOage">

    <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Enter Game Code: " FontSize="20"/>
            <TextBox x:Name="GameCodeTextBlock" Width="200"/>
        </StackPanel>
        <Button Width="50" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Right" Click="Button_Click"/>

    </Grid>
</Page>
