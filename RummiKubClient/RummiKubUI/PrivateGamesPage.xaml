<Page x:Class="RummiKubUI.PrivateGamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RummiKubUI.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PrivateGamesPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" x:Name="HeadBackButtonPanel"  VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Frame x:Name="CreatePrivateGamePageFrame" Grid.Column="0"/>
        <Frame x:Name="JoinPrivateGamePageFrame" Grid.Column="1"/>
        <Frame x:Name="AfterPageFrame" Grid.ColumnSpan="2"/>
    </Grid>
</Page>
