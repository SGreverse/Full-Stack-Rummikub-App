<Page x:Class="RummiKubUI.PlayerAmountSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RummiKubUI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PlayerAmountSelectionPage">
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#87CEEB" Offset="0.0"/>
            <GradientStop Color="#4682B4" Offset="1.0"/>
        </LinearGradientBrush>
    </Page.Background>

    <Grid>
        <StackPanel x:Name="HeadBackButtonPanel" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Border BorderThickness="8" CornerRadius="20" >
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6495ED" Offset="0.0"/>
                    <GradientStop Color="#4169E1" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                <TextBlock Text="Select Number of Players"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           Margin="20"
                           HorizontalAlignment="Center"/>

                <ComboBox x:Name="PlayerComboBox"
                          Width="250"
                          Height="50"
                          FontSize="18"
                          Background="#ADD8E6"
                          Foreground="#2C3E50" 
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Margin="20"
                          SelectedIndex="0">
                    <ComboBoxItem Content="2 Players" Tag="2" Background="#87CEEB"/> <!-- Sky Blue -->
                    <ComboBoxItem Content="3 Players" Tag="3" Background="#4682B4"/> <!-- Steel Blue -->
                    <ComboBoxItem Content="4 Players" Tag="4" Background="#6495ED"/> <!-- Cornflower Blue -->
                </ComboBox>

                <!-- Confirm Button with blue gradient background -->
                <Button Content="Enter Queue"
                        Margin="20"
                        Width="180"
                        Height="60"
                        FontSize="18"
                        FontWeight="Bold" Click="EnterQueue_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4169E1" Offset="0.0"/> <!-- Royal Blue -->
                            <GradientStop Color="#6495ED" Offset="1.0"/> <!-- Cornflower Blue -->
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Foreground>White</Button.Foreground>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
