<Page x:Class="RummiKubUI.PlayerInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RummiKubUI.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PlayerInfoPage"
      >
    <Page.Resources>
        <local:EditDisplayConverter x:Key="editdisplayconverter"/>
        <local:ImageConverter x:Key="imageconverter"/>


        <!-- Edit Button Style -->
        <Style x:Key="EditButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFB3E5FC"/>
            <!-- Light blue -->
            <Setter Property="BorderBrush" Value="#FF0288D1"/>
            <!-- Dark blue border -->
            <Setter Property="Foreground" Value="#FF0288D1"/>
            <!-- Dark blue text -->
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Content" Value="✎"/>
            <!-- Pencil Icon -->
        </Style>
    </Page.Resources>

    <Grid>
        <StackPanel x:Name="HeadBackButton" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <StackPanel Margin="20" HorizontalAlignment="Center">

            <!-- User Icon Section -->
            <Grid HorizontalAlignment="Center" x:Name="HoverArea">
                <!-- Ellipse for User Icon -->
                <Ellipse x:Name="IconEllipse" Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding IconName, Converter={StaticResource imageconverter}}"/>
                    </Ellipse.Fill>

                </Ellipse>

                <!-- Hover Button Overlay -->
                <Button
                    x:Name="EditButton"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Click="EditButton_Click"
            Visibility="Hidden">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Width="200" Height="200">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="#80000000"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Edit" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- Show button when mouse is over the parent grid -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#80000000"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                </Button>

            </Grid>

            <!-- Spacer -->
            <Rectangle Height="20"/>

            <!-- User Details Section -->

            <!-- Username -->
            <StackPanel Orientation="Horizontal">
                <Grid>
                    <TextBlock Text="{Binding Username}" 
                           Foreground="white"
                           FontSize="16"    
                           x:Name="UsernameDisplayBox"
                           Width="100"
                           VerticalAlignment="Center"/>
                    <TextBox x:Name="UsernameEditBox"
                             Visibility="Collapsed"
                           FontSize="16"                           
                           Width="100"
                            Foreground="#FF333333"/>
                </Grid>
                        <Button Style="{StaticResource EditButtonStyle}" Visibility="{Binding .,Converter={StaticResource editdisplayconverter}}" ToolTip="Edit Username" Click="UsernameEdit"/>

            </StackPanel>

            <!-- First Name -->
            <StackPanel Orientation="Horizontal">
                <Grid>
                    <TextBlock Text="{Binding FirstName}" 
                    FontSize="16"    
                    x:Name="FirstNameDisplayBox"
                    Width="100"
                    Foreground="White" 
                    VerticalAlignment="Center"/>
                    <TextBox x:Name="FirstNameEditBox"
                    Visibility="Collapsed"
                    FontSize="16"                           
                    Width="100"
                    Foreground="#FF333333"/>
             </Grid>
                <Button Style="{StaticResource EditButtonStyle}" Visibility="{Binding .,Converter={StaticResource editdisplayconverter}}" ToolTip="Edit First Name" Click="FirstNameEdit"/>
                <Grid>
                    <TextBlock Text="{Binding LastName}" 
            FontSize="16"    
            x:Name="LastNameDisplayBox"
            Width="100"
            Foreground="White" 
            VerticalAlignment="Center"/>
                    <TextBox x:Name="LastNameEditBox"
              Visibility="Collapsed"
            FontSize="16"                           
            Width="100"
             Foreground="#FF333333"/>
                </Grid>
                <Button Style="{StaticResource EditButtonStyle}" Visibility="{Binding .,Converter={StaticResource editdisplayconverter}}" ToolTip="Edit Last Name" Click="LastNameEdit"/>
            </StackPanel>

            <!-- Last Name -->


            <!-- Email -->
            <StackPanel Orientation="Horizontal">
                <Grid>
                    <TextBlock Text="{Binding Email}" 
            FontSize="16"    
            x:Name="EmailDisplayBox"
            Width="100"
            Foreground="White" 
            VerticalAlignment="Center"/>
                    <TextBox x:Name="EmailEditBox"
              Visibility="Collapsed"
            FontSize="16"                           
            Width="100"
             Foreground="#FF333333"/>
                </Grid>
                <Button Style="{StaticResource EditButtonStyle}" Visibility="{Binding .,Converter={StaticResource editdisplayconverter}}" ToolTip="Edit Email" Click="EmailEdit"/>
            </StackPanel>

            <!-- City -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding User_City.CityName}" 
                           FontSize="16" 
                           Width="100"
                           Foreground="#FF333333" 
                           VerticalAlignment="Center"/>
                <Button Style="{StaticResource EditButtonStyle}" Visibility="{Binding .,Converter={StaticResource editdisplayconverter}}" ToolTip="Edit City"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
